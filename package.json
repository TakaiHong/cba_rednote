{
  "name": "singapore-storage-xhs-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --host 127.0.0.1 --port 5173 client",
    "build": "tsc -p tsconfig.json && vite build client",
    "start": "node dist/server/src/index.js",
    "local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-local.ps1",
    "health": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/health-check.ps1",
    "backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-data.ps1",
    "backup:dry-run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-data.ps1 -DryRun",
    "generate": "tsx server/src/cli/generate.ts",
    "status": "tsx server/src/cli/status.ts",
    "readiness": "tsx scripts/readiness.ts",
    "export": "tsx scripts/export-xhs.ts",
    "publish": "tsx scripts/publish-xhs.ts",
    "publish:preflight": "tsx scripts/publish-xhs.ts --post latest --preflight --no-pause",
    "schedule:dry-run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-daily-task.ps1 -DryRun",
    "schedule:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-daily-task.ps1",
    "schedule:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-daily-task.ps1 -Uninstall",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run lint && npm run test && npm run build && npm run status && npm run readiness && npm run publish -- --post latest --dry-run && npm run export -- --post latest --out .tmp/verify-exports && npm run backup:dry-run && npm run schedule:dry-run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "node-cron": "^4.2.1",
    "playwright": "^1.55.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "uuid": "^11.1.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  }
}
