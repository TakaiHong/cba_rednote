{
  "name": "ntu-cba-xhs-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --host 127.0.0.1 --port 5173 client",
    "build": "tsc -p tsconfig.json && vite build client --outDir ../dist --emptyOutDir",
    "start": "node dist/server/src/index.js",
    "local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-local.ps1",
    "health": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/health-check.ps1",
    "ui:smoke": "tsx scripts/ui-smoke.ts",
    "backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-data.ps1",
    "backup:dry-run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-data.ps1 -DryRun",
    "generate": "tsx server/src/cli/generate.ts",
    "generate:batch": "tsx scripts/generate-batch.ts",
    "status": "tsx server/src/cli/status.ts",
    "readiness": "tsx scripts/readiness.ts",
    "go-live:check": "tsx scripts/go-live-check.ts",
    "calendar": "tsx scripts/plan-calendar.ts",
    "handoff": "tsx scripts/handoff-package.ts",
    "image:brief": "tsx scripts/prepare-image-assets.ts",
    "image:cover": "tsx scripts/generate-cover-image.ts",
    "export": "tsx scripts/export-xhs.ts",
    "report": "tsx scripts/export-performance-report.ts",
    "publish": "tsx scripts/publish-xhs.ts",
    "publish:preflight": "tsx scripts/publish-xhs.ts --post latest --preflight --no-pause --preflight-report .tmp/xhs-preflight-report.json",
    "publish:preflight:manual": "tsx scripts/publish-xhs.ts --post latest --preflight --wait-before-preflight --preflight-report .tmp/xhs-preflight-report.json",
    "schedule:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-daily-task.ps1",
    "schedule:dry-run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-daily-task.ps1 -DryRun",
    "schedule:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-daily-task.ps1",
    "schedule:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-daily-task.ps1 -Uninstall",
    "gcp:migrate": "tsx scripts/migrate-json-to-firestore.ts",
    "d1:migration:export": "tsx scripts/export-d1-migration.ts",
    "sites:migrate-data": "tsx scripts/migrate-local-data-to-site.ts",
    "worker:typecheck": "tsc -p worker/tsconfig.json --noEmit",
    "firebase:build": "vite build client --outDir dist --emptyOutDir",
    "firebase:deploy": "npm run firebase:build && firebase deploy --only hosting",
    "sites:build": "npm run firebase:build && node scripts/build-sites.mjs",
    "secrets:scan": "tsx scripts/check-secrets.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run secrets:scan && npm run lint && npm run test && npm run build && npm run status && npm run readiness && npm run generate:batch -- --count 7 --dry-run && npm run publish -- --post latest --dry-run && npm run export -- --post latest --out .tmp/verify-exports && npm run report -- --out .tmp/verify-reports && npm run image:brief -- --post latest --out .tmp/verify-image-assets && npm run handoff -- --out .tmp/verify-handoff && npm run backup:dry-run && npm run schedule:dry-run && npm run schedule:status"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "firebase": "^12.1.0",
    "firebase-admin": "^14.2.0",
    "jose": "^6.1.0",
    "lucide-react": "^1.27.0",
    "node-cron": "^4.2.1",
    "playwright": "^1.55.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "uuid": "^11.1.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "wrangler": "^4.27.0"
  }
}
