PORT=8787
HOST=0.0.0.0
# Required for any public deployment. The local app stays open when it is blank.
DASHBOARD_USERNAME=operator
DASHBOARD_PASSWORD=
# local keeps JSON files; Cloud Run uses Firestore and Cloud Storage instead.
PERSISTENCE_PROVIDER=local
ASSET_STORAGE_PROVIDER=local
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
CLOUD_RUNTIME=false
CLOUD_SCHEDULER_TOKEN=
DAILY_CRON=15 9 * * *
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODEL_COST_CNY_PER_POST_ESTIMATE=0.12
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
MODEL_COST_CNY_PER_POST_ESTIMATE=0.12
MAX_COST_CNY_PER_POST=0.5
XHS_CREATOR_URL=https://creator.xiaohongshu.com/
XHS_ALLOW_FINAL_PUBLISH=false
# Default content pool is data/ntu-cba. Set DATA_DIR only for a separate workspace.
